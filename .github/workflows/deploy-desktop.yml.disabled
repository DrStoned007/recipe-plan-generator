name: Desktop Deployment

on:
  workflow_dispatch:
    inputs:
      platforms:
        description: 'Platforms to build'
        required: true
        default: 'windows,macos,linux'
        type: string
      release_type:
        description: 'Release type'
        required: true
        default: 'beta'
        type: choice
        options:
        - alpha
        - beta
        - stable

  push:
    tags:
      - 'v*-desktop'

env:
  FLUTTER_VERSION: '3.22.x'

jobs:
  build_desktop:
    name: Build ${{ matrix.platform }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - platform: windows
            os: windows-latest
            build_cmd: 'flutter build windows --release'
            artifact_path: 'build/windows/x64/runner/Release/'
            installer_cmd: 'iscc windows/installer.iss'
          - platform: macos
            os: macos-latest
            build_cmd: 'flutter build macos --release'
            artifact_path: 'build/macos/Build/Products/Release/'
            installer_cmd: 'create-dmg --volname "NutriPlan" --window-pos 200 120 --window-size 600 300 --icon-size 100 --icon "NutriPlan.app" 175 120 --hide-extension "NutriPlan.app" --app-drop-link 425 120 "NutriPlan.dmg" "build/macos/Build/Products/Release/"'
          - platform: linux
            os: ubuntu-latest
            build_cmd: 'flutter build linux --release'
            artifact_path: 'build/linux/x64/release/bundle/'
            installer_cmd: 'snapcraft'
    
    defaults:
      run:
        working-directory: ./nutriplan_app
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      
    - name: Setup Flutter
      uses: subosito/flutter-action@v2
      with:
        flutter-version: ${{ env.FLUTTER_VERSION }}
        cache: true
        
    - name: Install Linux dependencies
      if: matrix.platform == 'linux'
      run: |
        sudo apt-get update
        sudo apt-get install -y clang cmake ninja-build pkg-config libgtk-3-dev liblzma-dev libblkid-dev
        sudo snap install snapcraft --classic
        
    - name: Install macOS dependencies
      if: matrix.platform == 'macos'
      run: |
        brew install create-dmg
        
    - name: Install Windows dependencies
      if: matrix.platform == 'windows'
      run: |
        choco install innosetup -y
        
    - name: Get dependencies
      run: flutter pub get
      
    - name: Generate code
      run: flutter packages pub run build_runner build --delete-conflicting-outputs
      
    - name: Configure desktop platforms
      run: |
        flutter config --enable-windows-desktop
        flutter config --enable-macos-desktop
        flutter config --enable-linux-desktop
        
    - name: Build ${{ matrix.platform }} app
      run: |
        ${{ matrix.build_cmd }} \
          --dart-define=SUPABASE_URL=${{ secrets.SUPABASE_URL }} \
          --dart-define=SUPABASE_ANON_KEY=${{ secrets.SUPABASE_ANON_KEY }} \
          --dart-define=GOOGLE_SIGN_IN_CLIENT_ID=${{ secrets.GOOGLE_SIGN_IN_CLIENT_ID }}
          
    - name: Code sign Windows app
      if: matrix.platform == 'windows'
      run: |
        # Add Windows code signing here
        echo "Signing Windows executable..."
        
    - name: Code sign macOS app
      if: matrix.platform == 'macos'
      run: |
        # Add macOS code signing here
        echo "Signing macOS application..."
        codesign --force --deep --sign "${{ secrets.MACOS_CERTIFICATE_NAME }}" "${{ matrix.artifact_path }}NutriPlan.app"
        
    - name: Create installer/package
      run: |
        ${{ matrix.installer_cmd }}
        
    - name: Notarize macOS app
      if: matrix.platform == 'macos'
      run: |
        # Add macOS notarization here
        echo "Notarizing macOS application..."
        xcrun notarytool submit "NutriPlan.dmg" --keychain-profile "notarytool-profile" --wait
        xcrun stapler staple "NutriPlan.dmg"
        
    - name: Upload build artifacts
      uses: actions/upload-artifact@v3
      with:
        name: desktop-${{ matrix.platform }}-${{ github.sha }}
        path: |
          nutriplan_app/${{ matrix.artifact_path }}
          nutriplan_app/*.dmg
          nutriplan_app/*.exe
          nutriplan_app/*.deb
          nutriplan_app/*.snap
        retention-days: 30

  publish_desktop:
    name: Publish Desktop Apps
    runs-on: ubuntu-latest
    needs: build_desktop
    if: startsWith(github.ref, 'refs/tags/') || github.event_name == 'workflow_dispatch'
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      
    - name: Download all artifacts
      uses: actions/download-artifact@v3
      
    - name: Prepare release assets
      run: |
        mkdir -p release-assets
        find . -name "*.exe" -exec cp {} release-assets/ \;
        find . -name "*.dmg" -exec cp {} release-assets/ \;
        find . -name "*.deb" -exec cp {} release-assets/ \;
        find . -name "*.snap" -exec cp {} release-assets/ \;
        find . -name "*.AppImage" -exec cp {} release-assets/ \;
        
    - name: Create GitHub Release
      if: startsWith(github.ref, 'refs/tags/')
      uses: softprops/action-gh-release@v1
      with:
        files: release-assets/*
        draft: false
        prerelease: ${{ contains(github.ref, 'alpha') || contains(github.ref, 'beta') }}
        
    - name: Publish to Microsoft Store
      if: contains(github.event.inputs.platforms, 'windows') && inputs.release_type == 'stable'
      run: |
        # Add Microsoft Store publishing logic
        echo "Publishing to Microsoft Store..."
        
    - name: Publish to Mac App Store
      if: contains(github.event.inputs.platforms, 'macos') && inputs.release_type == 'stable'
      run: |
        # Add Mac App Store publishing logic
        echo "Publishing to Mac App Store..."
        
    - name: Publish to Snap Store
      if: contains(github.event.inputs.platforms, 'linux') && inputs.release_type == 'stable'
      run: |
        echo ${{ secrets.SNAPCRAFT_STORE_CREDENTIALS }} | snapcraft login --with -
        snapcraft upload --release=stable release-assets/*.snap
        
    - name: Update auto-updater manifests
      run: |
        # Update auto-updater configuration files
        echo "Updating auto-updater manifests..."
        
    - name: Notify release
      uses: 8398a7/action-slack@v3
      if: always()
      with:
        status: ${{ job.status }}
        channel: '#desktop-releases'
        fields: repo,message,commit,author,action,eventName,ref,workflow
        webhook_url: ${{ secrets.SLACK_WEBHOOK }}

  post_release_verification:
    name: Post-Release Verification
    runs-on: ${{ matrix.os }}
    needs: publish_desktop
    if: success()
    strategy:
      matrix:
        os: [windows-latest, macos-latest, ubuntu-latest]
    
    steps:
    - name: Download and test installer
      run: |
        # Download and test the installer for each platform
        echo "Testing installer on ${{ matrix.os }}..."
        
    - name: Verify auto-updater
      run: |
        # Test auto-update functionality
        echo "Verifying auto-updater on ${{ matrix.os }}..."
        
    - name: Upload verification results
      uses: actions/upload-artifact@v3
      if: always()
      with:
        name: verification-results-${{ matrix.os }}
        path: verification-results/